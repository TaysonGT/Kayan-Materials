{
  "name": "kayan-materials",
  "version": "0.0.1",
  "description": "Kayan Materials Management System - MVP",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "type": "module",
  "scripts": {
    "install:all": "npm install",
    "install:client": "npm install --workspace=client",
    "install:server": "npm install --workspace=server",
    "build:all": "npm run build --workspace=server && npm run build --workspace=client",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "start:all": "npm run start --workspace=server & npm run start --workspace=client",
    "start:client": "npm run start --workspace=client",
    "start:server": "npm run start --workspace=server",
    "dev:all": "npm run dev --workspace=client & npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "preview:cloudflare": "wrangler dev",
    "deploy:cloudflare": "wrangler deploy",
    "lint": "npm run lint:server && npm run lint:client",
    "lint:server": "cd server && npm run lint 2>/dev/null || true",
    "lint:client": "cd client && npm run lint"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TaysonGT/kayan-materials.git"
  },
  "keywords": [
    "materials",
    "suppliers",
    "transactions",
    "inventory",
    "management"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@mui/stylis-plugin-rtl": "^9.1.1"
  }
}
